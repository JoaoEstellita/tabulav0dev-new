rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras temporárias mais permissivas para debugging
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /users/{userId}/astrologyCache/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    match /userPublicProfiles/{userId} {
      allow read, write: if request.auth != null;
    }

    match /userStatus/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /groupAlerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    match /groupMemberSettings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /couples/{relationshipId} {
      allow read, write: if request.auth != null;
    }

    match /coupleRelationships/{relationshipId} {
      allow read, write: if request.auth != null;
    }
  }
}
