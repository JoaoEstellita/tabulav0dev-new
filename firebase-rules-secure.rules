rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== REGRAS PARA USUARIOS =====
    match /users/{userId} {
      // Usuario pode ler/escrever apenas seus proprios dados
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Permitir criacao de perfil durante onboarding
      allow create: if request.auth != null && request.auth.uid == userId;

      match /webPushSubscriptions/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== REGRAS PARA PERFIS PUBLICOS =====
    match /userPublicProfiles/{userId} {
      // Qualquer usuario autenticado pode ler
      allow read: if request.auth != null;

      // Usuario pode criar/atualizar apenas o proprio perfil publico
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }

    // ===== REGRAS PARA ASSINATURAS =====
    match /subscriptions/{subscriptionId} {
      // Usuario pode ler/escrever apenas suas proprias assinaturas
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;

      // Permitir criacao de assinatura
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId;
    }

    // ===== REGRAS PARA GRUPOS =====
    match /groups/{groupId} {
      // Membros podem ler o grupo
      allow read: if request.auth != null && 
                     request.auth.uid in resource.data.members;

      // Apenas o criador pode criar grupo
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.createdBy;

      // Membros podem atualizar o grupo
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.members;

      // Apenas o criador pode deletar o grupo
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.createdBy;
    }

    // ===== REGRAS PARA STATUS DE MEMBRO NO GRUPO =====
    match /groups/{groupId}/memberStatus/{userId} {
      // Membros do grupo podem ler o status compartilhado
      allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;

      // Usuario pode escrever apenas o proprio status no grupo
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ===== REGRAS PARA ALERTAS DE GRUPOS =====
    match /groupAlerts/{alertId} {
      // Membros do grupo podem ler alertas
      allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // Usuario pode criar alertas para grupos que participa
      allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members;

      // Apenas o criador pode atualizar/deletar alerta
      allow update, delete: if request.auth != null &&
                              request.auth.uid == resource.data.createdBy;
    }

    // ===== REGRAS PARA ATIVIDADES DE GRUPO =====
    match /groupActivities/{activityId} {
      // Membros do grupo podem ler atividades
      allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // Somente backend grava atividades
      allow create, update, delete: if false;
    }

    // ===== REGRAS PARA CONFIGURACOES DE MEMBRO NO GRUPO =====
    match /groupMemberSettings/{docId} {
      // Usuario pode ler apenas suas configuracoes no grupo
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.userId &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // Usuario pode criar configuracoes apenas para si e em grupo que participa
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members;

      // Usuario pode atualizar apenas suas configuracoes no grupo
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.userId &&
                       request.auth.uid == request.resource.data.userId &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      allow delete: if false;
    }

    // ===== REGRAS PARA STATUS PUBLICO =====
    match /userStatus/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // ===== REGRAS PARA RELACIONAMENTOS DE CASAL =====
    match /coupleRelationships/{relationshipId} {
      // Usuarios podem ler/escrever apenas seus proprios relacionamentos
      allow read, write: if request.auth != null &&
                           (request.auth.uid == resource.data.userId ||
                            request.auth.uid == resource.data.partnerId);

      // Permitir criacao de relacionamento
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId;
    }

    // ===== REGRAS PARA CASAIS (COLLECTION ATUAL) =====
    match /couples/{relationshipId} {
      allow read, write: if request.auth != null &&
                           (request.auth.uid == resource.data.partner1.userId ||
                            request.auth.uid == resource.data.partner2.userId);

      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.partner1.userId;
    }

    // ===== REGRAS PARA CACHE ASTROLOGICO =====
    match /astrologyCache/{cacheId} {
      // Usuario pode ler/escrever apenas seu proprio cache
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;

      // Permitir criacao de cache
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId;
    }

    // ===== REGRAS PARA NOTIFICACOES =====
    match /notifications/{notificationId} {
      // Usuario pode ler apenas suas proprias notificacoes
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.userId;

      // Somente backend/service account cria notificacoes
      allow create: if false;

      // Usuario pode marcar como lida
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead', 'readAt']);

      allow delete: if false;
    }

    // ===== REGRAS PARA CONFIGURACOES DE ALERTA =====
    match /alertSettings/{settingId} {
      // Usuario pode ler/escrever apenas suas proprias configuracoes
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;

      // Permitir criacao de configuracoes
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId;
    }

    // ===== REGRAS PARA LOGS DE SISTEMA =====
    match /systemLogs/{logId} {
      // Apenas leitura para logs do sistema
      allow read: if request.auth != null;

      // Sistema pode criar logs
      allow create: if request.auth != null;
    }

    // ===== REGRAS PARA DADOS PUBLICOS =====
    match /publicData/{docId} {
      // Dados publicos podem ser lidos por qualquer usuario autenticado
      allow read: if request.auth != null;

      // Apenas administradores podem escrever dados publicos
      allow write: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/admin/users).data.adminUsers;
    }

    // ===== REGRAS PARA ADMINISTRADORES =====
    match /admin/{collection}/{docId} {
      // Apenas administradores podem acessar dados administrativos
      allow read, write: if request.auth != null &&
                           request.auth.uid in get(/databases/$(database)/documents/admin/users).data.adminUsers;
    }

    // ===== REGRAS PARA BACKUP E MIGRACAO =====
    match /backup/{backupId} {
      // Apenas sistema pode acessar backups
      allow read, write: if request.auth != null &&
                           request.auth.token.admin == true;
    }

    // ===== REGRAS PARA SETTINGS (READ-ONLY NO CLIENT) =====
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{subCollection}/{subDoc} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}
