rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== REGRAS PARA USUÁRIOS =====
    match /users/{userId} {
      // Usuário pode ler/escrever apenas seus próprios dados
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Permitir criação de perfil durante onboarding
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // ===== REGRAS PARA PERFIS PUBLICOS =====
    match /userPublicProfiles/{userId} {
      // Qualquer usuario autenticado pode ler
      allow read: if request.auth != null;

      // Usuario pode criar/atualizar apenas o proprio perfil publico
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }
    
    // ===== REGRAS PARA ASSINATURAS =====
    match /subscriptions/{subscriptionId} {
      // Usuário pode ler/escrever apenas suas próprias assinaturas
      allow read, write: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      
      // Permitir criação de assinatura
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
    }
    
    // ===== REGRAS PARA GRUPOS =====
    match /groups/{groupId} {
      // Membros podem ler o grupo
      allow read: if request.auth != null && 
                     request.auth.uid in resource.data.members;
      
      // Apenas o criador pode criar grupo
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.createdBy;
      
      // Membros podem atualizar o grupo
      allow update: if request.auth != null && 
                       request.auth.uid in resource.data.members;
      
      // Apenas o criador pode deletar o grupo
      allow delete: if request.auth != null && 
                       request.auth.uid == resource.data.createdBy;
    }
    
    // ===== REGRAS PARA ALERTAS DE GRUPOS =====
    match /groupAlerts/{alertId} {
      // Membros do grupo podem ler alertas
      allow read: if request.auth != null && 
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;
      
      // Usuário pode criar alertas para grupos que participa
      allow create: if request.auth != null && 
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members;
      
      // Apenas o criador pode atualizar/deletar alerta
      allow update, delete: if request.auth != null && 
                              request.auth.uid == resource.data.createdBy;
    }

    // ===== REGRAS PARA CONFIGURACOES DE MEMBRO NO GRUPO =====
    match /groupMemberSettings/{docId} {
      // Usuario pode ler apenas suas configuracoes no grupo
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.userId &&
                     request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // Usuario pode criar configuracoes apenas para si e em grupo que participa
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members;

      // Usuario pode atualizar apenas suas configuracoes no grupo
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.userId &&
                       request.auth.uid == request.resource.data.userId &&
                       request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      allow delete: if false;
    }

    // ===== REGRAS PARA STATUS PUBLICO =====
    match /userStatus/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== REGRAS PARA RELACIONAMENTOS DE CASAL =====
    match /coupleRelationships/{relationshipId} {
      // Usuários podem ler/escrever apenas seus próprios relacionamentos
      allow read, write: if request.auth != null && 
                           (request.auth.uid == resource.data.userId || 
                            request.auth.uid == resource.data.partnerId);
      
      // Permitir criação de relacionamento
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
    }

    // ===== REGRAS PARA CASAIS (COLLECTION ATUAL) =====
    match /couples/{relationshipId} {
      allow read, write: if request.auth != null &&
                           (request.auth.uid == resource.data.partner1.userId ||
                            request.auth.uid == resource.data.partner2.userId);

      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.partner1.userId;
    }
    
    // ===== REGRAS PARA CACHE ASTROLÓGICO =====
    match /astrologyCache/{cacheId} {
      // Usuário pode ler/escrever apenas seu próprio cache
      allow read, write: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      
      // Permitir criação de cache
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
    }
    
    // ===== REGRAS PARA NOTIFICAÇÕES =====
    match /notifications/{notificationId} {
      // Usuário pode ler apenas suas próprias notificações
      allow read: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
      
      // Sistema pode criar notificações para usuários
      allow create: if request.auth != null;
      
      // Usuário pode marcar como lida
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.userId;
    }
    
    // ===== REGRAS PARA CONFIGURAÇÕES DE ALERTA =====
    match /alertSettings/{settingId} {
      // Usuário pode ler/escrever apenas suas próprias configurações
      allow read, write: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      
      // Permitir criação de configurações
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.userId;
    }
    
    // ===== REGRAS PARA LOGS DE SISTEMA =====
    match /systemLogs/{logId} {
      // Apenas leitura para logs do sistema
      allow read: if request.auth != null;
      
      // Sistema pode criar logs
      allow create: if request.auth != null;
    }
    
    // ===== REGRAS PARA DADOS PÚBLICOS =====
    match /publicData/{docId} {
      // Dados públicos podem ser lidos por qualquer usuário autenticado
      allow read: if request.auth != null;
      
      // Apenas administradores podem escrever dados públicos
      allow write: if request.auth != null && 
                     request.auth.uid in get(/databases/$(database)/documents/admin/users).data.adminUsers;
    }
    
    // ===== REGRAS PARA ADMINISTRADORES =====
    match /admin/{collection}/{docId} {
      // Apenas administradores podem acessar dados administrativos
      allow read, write: if request.auth != null && 
                           request.auth.uid in get(/databases/$(database)/documents/admin/users).data.adminUsers;
    }
    
    // ===== REGRAS PARA BACKUP E MIGRAÇÃO =====
    match /backup/{backupId} {
      // Apenas sistema pode acessar backups
      allow read, write: if request.auth != null && 
                           request.auth.token.admin == true;
    }
  }
} 
