rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function onlyReadFlagsChanged() {
      return request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;

      match /webPushSubscriptions/{subId} {
        allow read, write: if isSelf(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isSelf(userId);
      }

      match /astrologyCache/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /userPublicProfiles/{userId} {
      // O próprio dono sempre lê; terceiros só se o perfil está discoverable
      // (opt-in da Rede). Respeita o opt-out: quem desativou "aparecer na Rede"
      // não é mais legível por outros logados. Grupos degradam para `users`
      // via GroupService (o read negado não derruba o carregamento do grupo).
      allow read: if isSelf(userId) || resource.data.discoverable == true;
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /userStatus/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if isGroupMember(groupId);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /memberStatus/{userId} {
        allow read: if isGroupMember(groupId);
        allow write: if isSelf(userId) && isGroupMember(groupId);
      }
    }

    match /groupMemberSettings/{docId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        isGroupMember(resource.data.groupId);

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        isGroupMember(request.resource.data.groupId);

      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        request.auth.uid == request.resource.data.userId &&
        isGroupMember(resource.data.groupId);

      allow delete: if false;
    }

    match /groupAlerts/{alertId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create, update, delete: if false;
    }

    match /groupActivities/{activityId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        onlyReadFlagsChanged();
      allow delete: if false;
    }

    match /couples/{relationshipId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.partner1.userId ||
         request.auth.uid == resource.data.partner2.userId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.partner1.userId;
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.partner1.userId ||
         request.auth.uid == resource.data.partner2.userId);
      allow delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /fcmTokens/{tokenId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /{subCollection}/{subDoc} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /alertSettings/{settingId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
