{
  "expo": {
    "name": "Tábula Estelar",
    "slug": "tabula-estelar-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e27"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e27"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.estellita.tabulaestelar",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "scheme": "tabulaestelar",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": ["@expo/vector-icons"]
        }
      },
      "pwa": {
        "name": "Tábula Estelar - Seu Guia Astrológico Pessoal",
        "short_name": "Tábula Estelar",
        "description": "Descubra como os astros influenciam sua vida com análises precisas e insights personalizados",
        "theme_color": "#0a0e27",
        "background_color": "#0a0e27",
        "display": "standalone",
        "orientation": "portrait-primary",
        "scope": "/",
        "start_url": "/",
        "lang": "pt-BR",
        "categories": ["lifestyle", "astrology", "productivity"],
        "icons": [
          {
            "src": "./assets/adaptive-icon.png",
            "sizes": "1024x1024",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "./assets/icon.png",
            "sizes": "1024x1024",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "./assets/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "./assets/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          }
        ],
        "shortcuts": [
          {
            "name": "Mapa Astral",
            "short_name": "Mapa",
            "description": "Visualizar seu mapa astral",
            "url": "/?shortcut=mapa",
            "icons": [
              {
                "src": "./assets/icon-96.png",
                "sizes": "96x96"
              }
            ]
          },
          {
            "name": "Trânsitos",
            "short_name": "Trânsitos",
            "description": "Ver trânsitos atuais",
            "url": "/?shortcut=transitos",
            "icons": [
              {
                "src": "./assets/icon-96.png",
                "sizes": "96x96"
              }
            ]
          },
          {
            "name": "Grupos",
            "short_name": "Grupos",
            "description": "Acessar grupos astrológicos",
            "url": "/?shortcut=grupos",
            "icons": [
              {
                "src": "./assets/icon-96.png",
                "sizes": "96x96"
              }
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "e10113f7-a65c-4374-aa0e-c849346d7ed7"
      },
      "firebase": {
        "senderId": "729037358278"
      }
    }
  }
}
