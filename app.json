{
  "expo": {
    "name": "Tábula Estelar",
    "slug": "tabula-estelar-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e27"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FFD700"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e27"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.estellita.tabulaestelar",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estellita.tabulaestelar",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "scheme": "tabulaestelar",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      },
      "pwa": {
        "manifest": "./public/manifest.json"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e10113f7-a65c-4374-aa0e-c849346d7ed7"
      },
      "firebase": {
        "senderId": "729037358278"
      }
    }
  }
}