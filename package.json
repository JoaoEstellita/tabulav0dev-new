{
  "name": "tabula-estelar-new",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --clear && node scripts/copyPublicToDist.js",
    "build:web": "expo export --platform web --clear && node scripts/copyPublicToDist.js",
    "build:pwa": "expo export --platform web --clear && node scripts/copyPublicToDist.js",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios",
    "init-firestore": "node scripts/initFirestore.js",
    "deploy:web": "npm run build:web && vercel --prod",
    "deploy:pwa": "npm run build:pwa && vercel --prod",
    "test": "npm exec vitest run --pool=forks",
    "guard:forecast": "node scripts/check-forecast-guard.js",
    "guard:i18n": "node scripts/check-i18n-hardcoded.js",
    "audit:transits": "node scripts/audit-transit-catalog-runtime-coverage.js",
    "smoke:rc": "npm exec vitest run src/services/status/__tests__/status-policy.smoke.spec.ts src/services/backend/__tests__/client.smoke.spec.ts --pool=forks",
    "test:rules": "firebase emulators:exec --only firestore \"npm exec vitest run src/firestore-rules/__tests__/firestore.rules.spec.ts --pool=forks\"",
    "smoke:security": "npm run smoke:rc && npm run test:rules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.4.4",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/stack": "^7.4.4",
    "@sentry/react-native": "~6.14.0",
    "animejs": "^3.2.1",
    "astronomy-engine": "^2.1.19",
    "axios": "^1.13.5",
    "ephemeris": "^2.2.0",
    "expo": "~53.0.27",
    "expo-constants": "^17.1.7",
    "expo-device": "^7.1.4",
    "expo-file-system": "^18.1.11",
    "expo-font": "^13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "^7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "firebase": "^12.0.0",
    "mercadopago": "^2.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.20.0"
  },
  "overrides": {
    "axios": "^1.13.5",
    "lodash": "^4.17.23",
    "undici": "^7.24.0",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10",
    "websocket-driver": "^0.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "~19.0.10",
    "firebase-tools": "^15.6.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
